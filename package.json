{
  "name": "amadeus-for-dsh",
  "version": "2.4.1",
  "description": "Steins;Gate 0 Amadeus (Makise Kurisu) 鍔╂墜锛歀ive2D 缈荤洊鎵嬫満 + 鏃ヨ璇煶 + 闀挎湡璁板繂锛孌eepSeek Harness 鎻掍欢",
  "type": "module",
  "main": "index.js",
  "exports": {
    ".": "./host.mjs",
    "./index.js": "./index.js",
    "./client": "./client.js",
    "./package.json": "./package.json"
  },
  "files": [
    "host.mjs",
    "client.js",
    "client.mjs",
    "index.js",
    "cordis.patch.yml",
    "assets",
    "config/amadeus.json",
    "config/manifest.json",
    "persona",
    "plugin/web",
    "tools/tts_emote.py",
    "tools/stt.py",
    "tools/llm_chat.py",
    "tools/mem_save.py",
    "tools/tts_server.py",
    "tools/Amadeus-OneClick.ps1",
    "README.md",
    "LICENSE"
  ],
  "dsh": {
    "bundle": {
      "patch": "./cordis.patch.yml"
    },
    "client": {
      "platform": "web",
      "inject": [
        "@deepseek-ai/dsh-client-ui-slots",
        "@deepseek-ai/dsh-client-ui-theme",
        "@deepseek-ai/dsh-client-ui-layout",
        "@deepseek-ai/dsh-client-ui-sidebar-right"
      ]
    }
  },
  "keywords": [
    "dsh",
    "deepseek-harness",
    "plugin",
    "live2d",
    "amadeus",
    "steins-gate",
    "tts"
  ],
  "devDependencies": {
    "esbuild": "^0.25.12"
  },
  "license": "MIT"
}